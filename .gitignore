# =============================================================================
# GASTIFY — arquivos ignorados pelo Git
# =============================================================================
# Regra de ouro: NENHUMA credencial entra no repositório. O `.env` real fica
# apenas na máquina de desenvolvimento; o modelo público é o `.env.example`.

# ------------------------------ Segredos -------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.jks
*.p12
*.mobileprovision

# ------------------------------ Python ---------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ------------------------- Node / Expo / Metro -------------------------------
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
npm-debug.*
yarn-debug.*
yarn-error.*
.metro-health-check*

# ------------------- Bancos portáteis e artefatos locais ---------------------
# Os binários e dados dos bancos ficam fora do repo (disco E:), mas o padrão
# fica registrado para evitar commit acidental em outra máquina.
pgsql/
pgdata/
mongodb/
mongodata/
*.log
*.zip

# ------------------------------ Editores / OS --------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
