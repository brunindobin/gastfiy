# =============================================================================
# GASTIFY API — modelo de variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` e preencha os valores reais:
#     Windows PowerShell : Copy-Item .env.example .env
#     Linux / macOS      : cp .env.example .env
#
# REGRA DE SEGURANÇA (AGENTS.md): o `.env` NUNCA é versionado e nenhuma
# credencial pode ser escrita no código. O `.gitignore` já bloqueia o `.env`.
# =============================================================================

# ------------------------------ Aplicação ------------------------------------
APP_NAME=GASTIFY API
APP_VERSION=1.0.0
# development | staging | production
ENVIRONMENT=development
# DEBUG=true liga /docs, /redoc e logs detalhados. Em produção: false.
DEBUG=true
API_V1_PREFIX=/api/v1
# Cria as tabelas no startup (atalho de desenvolvimento; em produção use Alembic).
AUTO_CREATE_TABLES=true

# ------------------------- Banco principal (PostgreSQL) ----------------------
# A URL de conexão é MONTADA a partir das partes abaixo — não existe
# DATABASE_URL pronta para preencher (e não há valores reais neste arquivo).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gastify

# Pool de conexões (ajuste conforme o ambiente; os padrões servem para dev).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
# Segundos para desistir de abrir conexão (mantém o /health rápido).
DB_CONNECT_TIMEOUT=5
# true espelha o SQL executado no console (use só para depurar).
DB_ECHO=false

# --------------------------------- CORS --------------------------------------
# "*" libera tudo (apenas desenvolvimento). Em produção, liste as origens:
#   CORS_ORIGINS=https://app.gastify.com.br,https://admin.gastify.com.br
CORS_ORIGINS=*

# ---------------------------------- JWT --------------------------------------
# Gere uma chave aleatória forte (>= 32 caracteres). Ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NUNCA use um valor fixo/publicado: qualquer pessoa poderia forjar tokens.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------- Banco secundário (Double Backup) ---------------------
# O MongoDB recebe o espelho de cada gasto. Se estiver fora, a API continua
# funcionando (o PostgreSQL é a fonte da verdade) e a falha fica só no log.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=gastify
MONGO_TIMEOUT_MS=3000
